<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Ins 浅色设计系统 · 色板（task-38）
      - 语义新色：bg_top / bg_bottom / surface / surface_alt / border_strong /
        primary / primary_deep / primary_soft / blue / blue_deep / text_hint /
        success / warn / danger
      - 兼容旧 key（全项目在用，只调值不改名）：bg_dark / bg_card / accent /
        accent_soft / accent_ink / accent_blue / blue_ink / blue_soft / border /
        text_primary / text_secondary / error
    -->

    <!-- 页面背景渐变（上 → 下） -->
    <color name="bg_top">#FFF8FB</color>
    <color name="bg_bottom">#EFF7FE</color>
    <!-- 卡片 / 内容面 -->
    <color name="surface">#FFFFFF</color>
    <color name="surface_alt">#FFFDFE</color>
    <!-- 描边 -->
    <color name="border_strong">#E8D5E0</color>
    <!-- 主色（粉） -->
    <color name="primary">#E8447A</color>
    <color name="primary_deep">#A61E46</color>
    <color name="primary_soft">#FFEAF2</color>
    <!-- 辅助色（蓝） -->
    <color name="blue">#6FB8E0</color>
    <color name="blue_deep">#2C7396</color>
    <!-- 文字 -->
    <color name="text_hint">#A99CB0</color>
    <!-- 状态色 -->
    <color name="success">#3E9D6E</color>
    <color name="warn">#D98324</color>
    <color name="danger">#C0392B</color>

    <!-- ===== 兼容旧 key（只调值，不改名；全项目引用） ===== -->
    <color name="bg_dark">#FFF8FB</color>
    <color name="bg_card">#FFFFFF</color>
    <color name="accent">#E8447A</color>
    <color name="accent_soft">#FFEAF2</color>
    <color name="accent_blue">#6FB8E0</color>
    <color name="blue_ink">#2C7396</color>
    <color name="blue_soft">#EAF5FC</color>
    <color name="border">#F2E4EC</color>
    <color name="text_primary">#3A3040</color>
    <!-- 小字/次要文字：原 #9C8AA3 在 #FFF7FB 上仅 3.03:1，此版 #7A6A82 在 #FFF8FB 上 ≈4.6:1 -->
    <color name="text_secondary">#7A6A82</color>
    <!-- accent 当文字色时的深版：白 7.25:1 / #FFF8FB 6.8:1 / primary_soft 6.0:1 -->
    <color name="accent_ink">#A61E46</color>
    <!-- 错误提示色（与 primary_deep 同值，保留旧引用） -->
    <color name="error">#A61E46</color>
</resources>